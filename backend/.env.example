# AITest 后端环境变量模板
# 用法：复制为 backend/.env 后按需修改。所有配置都有默认值，不建 .env 也能本地启动。

# ---------- 基础 ----------
APP_NAME=AITest
DEBUG=True

# ---------- 数据库 ----------
# 开发默认 SQLite；上线可换成 MySQL / PostgreSQL 连接串
DATABASE_URL=sqlite:///./aitest.db

# ---------- JWT ----------
# 【生产必改】至少 32 字节随机串，生成方式：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
# token 有效期（分钟），默认 24 小时
JWT_EXPIRE_MINUTES=1440

# ---------- 执行引擎 ----------
# 单次请求超时（秒）
REQUEST_TIMEOUT=5
# 【生产必改】False 表示拦截内网/回环地址，防止 SSRF；开发期可保持 True
ALLOW_PRIVATE_TARGET=True

# ---------- 大模型（留空则走规则生成，不影响演示） ----------
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
